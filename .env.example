UPSTREAM_URL=http://anvil:8545
FIREWALL_PORT=8546
CHAIN_ID=31337
# Host path of the sanctions list mounted into the firewall (one address per line)
SANCTIONS_LIST=./config/sanctions.txt
# Block when the summed weights of the findings reach this score
RISK_THRESHOLD=50
# pretty | text | json (use json in production)
LOG_FORMAT=pretty
# debug | info | warn | error
LOG_LEVEL=info