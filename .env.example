UPSTREAM_URL=http://anvil:8545
FIREWALL_PORT=8546
CHAIN_ID=31337
# Host path of the sanctions list mounted into the firewall (one address per line)
SANCTIONS_LIST=./config/sanctions.txt
# Optional mainnet RPC for the Chainalysis sanctions oracle; leave empty to disable
SANCTIONS_ORACLE_RPC=
# Block when the summed weights of the findings reach this score
RISK_THRESHOLD=50
# A contract counts as fresh if it was deployed within this many blocks (7200 = about a day on mainnet).
# The upstream node must keep state this far back; for a pruned Geth node use at most 127.
FRESH_CONTRACT_BLOCKS=7200
# Flag a contract whose net outflow of a token or ETH exceeds this share of what it held (1-100)
LARGE_OUTFLOW_PERCENT=50
# pretty | text | json (use json in production)
LOG_FORMAT=pretty
# debug | info | warn | error
LOG_LEVEL=info